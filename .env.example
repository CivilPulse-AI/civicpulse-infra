# Copy to .env and override as needed. docker compose interpolates these values.

# Required. External Postgres with PostGIS (no local database container).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/civicpulse?sslmode=require

REDIS_PORT=6379

JWT_SECRET=dev-insecure-change-me

SERVER_HTTP_PORT=8080
SERVER_GRPC_PORT=9090
AI_HTTP_PORT=8001
AI_GRPC_PORT=50051
TELEPHONY_HTTP_PORT=8002
NOTIFICATION_HTTP_PORT=8003

SERVICE_VERSION=0.1.0
