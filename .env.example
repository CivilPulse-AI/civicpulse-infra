# Copy to .env and fill in. docker compose interpolates these values.

# =============================================================================
# Required
# =============================================================================

# Platform DB (users, institutions, reports). Cockroach/Postgres URI.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
# Upstash Redis (streams, rate limits). Console → database → Connect → Redis URL.
# TLS URLs use rediss://. Upstash only has database 0, so leave the path off or use /0.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# GoAdmin’s own DB (goadmin_* tables). Same cluster, different database name.
# CREATE DATABASE civicpulse_admin;
GOADMIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/civicpulse_admin?sslmode=verify-full

# TLS for both URLs when sslmode=verify-full (Cockroach Cloud).
# DATABASE_CA_CERT = full PEM text. DATABASE_CA_CERT_PATH = file (compose cannot see host paths unless you mount them).
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

# HMAC signing key for citizen/institution JWTs. Any long random string (32+ chars). Example: openssl rand -base64 32
# Do not use the literal example value; the API refuses it.
JWT_SECRET=
# AES key for phone numbers at rest. One of:
#   - 32-char raw ASCII (AES-256), e.g. openssl rand -hex 16  → 32 hex chars is AES-128
#   - hex of 16, 24, or 32 bytes (32 / 48 / 64 hex chars)
#   - standard base64 of 16, 24, or 32 bytes
DATA_ENCRYPTION_KEY=
# Shared secret for telephony → core gRPC ingest. Any long random string. Example: openssl rand -hex 32
GRPC_INGEST_TOKEN=
# First-boot GoAdmin login password (username is always "admin"). Any password string; change after first login.
GOADMIN_PASSWORD=

# Google Gemini (AI service and survey agents). The AI process will not start without GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Google Cloud Speech (telephony). Relay uses Speech-to-Text and Text-to-Speech.
# Livewire and Relay both use the Gemini key below. Paste the service account as one JSON
# line, or base64-encode the file so compose does not expand dollar signs.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CLOUD_PROJECT=
# Maps Geocoding for CSV addresses. Empty still imports contacts, without coordinates.
GOOGLE_MAPS_API_KEY=
# Browser/phone WebSocket the citizen app should open. Host browsers use the published port.
TELEPHONY_PUBLIC_WS_URL=ws://127.0.0.1:8002
# Go API calls this to preview and bake Stencil audio.
TELEPHONY_INTERNAL_URL=http://127.0.0.1:8002
# Credits granted the first time an institution opens its wallet.
SURVEY_STARTER_CREDITS=5000
# WorldPop population totals for ward equity overlays. Calls work without a key (lower daily quota).
WORLDPOP_STATS_URL=https://api.worldpop.org/v1/services/stats
WORLDPOP_API_KEY=
# How often the API rescans complaint clusters for anomaly alerts.
ANOMALY_SCAN_MINUTES=15
# Razorpay payment links (UPI / INR). Empty leaves checkout disabled.
# Key id looks like rzp_live_... or rzp_test_.... Webhook secret is set on the Razorpay webhook, not the key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional page Razorpay opens after payment. Empty uses Razorpay's own success page.
RAZORPAY_CALLBACK_URL=
# Turn-based Relay model (ADK generateContent, not Live). Livewire uses the Live API.
RELAY_MODEL=gemini-3.8-flash
LIVE_MODEL=gemini-3.8-live

# Cloudflare R2 (S3-compatible access key + secret, same shape as AWS). The Go API stores
# report photos here. Leave all four empty to use local disk (Docker volume). Set all four
# on Render (free web disks are ephemeral). If any one is set, all four are required.
# Create an R2 API token with Object Read & Write. Account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# OTP channels: must be true or false. Both false = local debug_otp (no Fast2SMS).
# Either true requires the matching Fast2SMS vars in Optional below, or the process will not start.
OTP_SMS_ENABLED=false
OTP_WHATSAPP_ENABLED=false

# =============================================================================
# Optional
# =============================================================================

# HMAC secret for phone lookup hashes. Any long random string. Empty = uses JWT_SECRET.
PII_HASH_SECRET=
# X-Admin-Key for /v1/admin/* scripts. Any random string. Empty = those routes stay locked. UI is GoAdmin.
PLATFORM_ADMIN_KEY=

# Return debug_otp in the OTP API (local testing only). Default false.
OTP_REVEAL=false
# Seed demo citizen + institution and enable one-tap judge login. Default false.
# When true, also set OTP_SMS_ENABLED=false OTP_WHATSAPP_ENABLED=false OTP_REVEAL=true for manual phone login.
HACKATHON_DEMO=false
# CSV of municipal email hosts to seed on first boot only. Live list is edited in GoAdmin.
INSTITUTION_EMAIL_DOMAINS=
# CSV of browser origins for CORS. Empty = reflect request Origin (Flutter web / mobile).
CORS_ORIGINS=

# Fast2SMS. Required at startup if the matching OTP_*_ENABLED flag (or live GoAdmin toggle) is true.
# API key: Fast2SMS dashboard authorization token (opaque string).
FAST2SMS_API_KEY=
# WhatsApp Cloud phone-number id (digits) and approved template name.
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_TEMPLATE=

SERVER_HTTP_PORT=8080
SERVER_GRPC_PORT=9090
AI_HTTP_PORT=8001
AI_GRPC_PORT=50051
TELEPHONY_HTTP_PORT=8002
NOTIFICATION_HTTP_PORT=8003
SERVICE_VERSION=0.1.0

# Prefix used when the API writes public photo URLs into report JSON (e.g. https://api.example.com).
# Leave empty to build URLs from the request that created the report (scheme + Host header).
# Set this when phones/browsers cannot use that Host: Docker service names, an internal reverse
# proxy, or a public API hostname that differs from what the server saw on the upload.
MEDIA_PUBLIC_BASE_URL=

# R2 extras. Endpoint empty = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Region default auto.
R2_ENDPOINT=
R2_REGION=auto
# Public origin for anonymized photos only (r2.dev or custom domain), e.g. https://pub-xxxx.r2.dev
# Empty = phones fetch via GET /v1/media/:id (API streams from R2). Do not make the whole bucket
# public — originals live under {id}/original.*
R2_PUBLIC_BASE_URL=

# Hours after a crew marks resolved before the original reporter is asked "is this actually fixed?"
AUDIT_DELAY_HOURS=24

# Notification worker. Empty = log-only stubs. FCM_SERVER_KEY enables live Android/iOS pushes.
FCM_SERVER_KEY=
# Brevo transactional email (SLA escalations + weekly digests). Empty API key = log-only.
# Template IDs are the numeric IDs from Brevo (e.g. #5 → 5). FROM_EMAIL should match the template sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CivicPulse
BREVO_TEMPLATE_SLA_ESCALATION=5
BREVO_TEMPLATE_WEEKLY_DIGEST=6
