# Copy to .env and override as needed. docker compose interpolates these values.

# Required. CockroachDB Cloud or Postgres URI (no local database container).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
# Paste the Cockroach "Download CA Cert" PEM, or leave empty and use DATABASE_CA_CERT_PATH locally.
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=

REDIS_PORT=6379

JWT_SECRET=dev-insecure-change-me

SERVER_HTTP_PORT=8080
SERVER_GRPC_PORT=9090
AI_HTTP_PORT=8001
AI_GRPC_PORT=50051
TELEPHONY_HTTP_PORT=8002
NOTIFICATION_HTTP_PORT=8003

SERVICE_VERSION=0.1.0
